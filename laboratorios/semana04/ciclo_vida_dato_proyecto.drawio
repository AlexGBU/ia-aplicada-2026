<mxfile host="app.diagrams.net"><diagram name="ciclo_vida_dato_proyecto" id="ciclo1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Ciclo de vida del dato del proyecto — en rojo: recorrido del dato de mayor riesgo (nombre, correo y teléfono)" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#CC0000;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="s0" value="Captura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="t0" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; El registro de accesos llega como archivo (accesos_crudo.xlsx) con nombre, correo y teléfono de cada persona.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Responsable del proyecto (analista de datos)&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Captura mínima necesaria: solo se trabaja con las columnas que el análisis requiere." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#FFFFFF;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="220" height="210" as="geometry"/></mxCell><mxCell id="s1" value="Almacenamiento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; El original se guarda intacto y la limpieza se hace en una copia (accesos_limpio).&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Analista de datos / proveedor de nube&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Original de solo lectura, copia de trabajo, acceso con contraseña y respaldo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#FFFFFF;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="310" y="310" width="220" height="210" as="geometry"/></mxCell><mxCell id="x1" value="Servicio de nube donde vive el archivo" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="180" height="60" as="geometry"/></mxCell><mxCell id="s2" value="Uso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Se limpia, se valida y se buscan accesos inusuales (fuera de 06:00-22:00).&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Analista de datos&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Uso limitado al fin declarado (patrones de acceso) y registro de cambios en incidencias." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#FFFFFF;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="580" y="310" width="220" height="210" as="geometry"/></mxCell><mxCell id="x2" value="Modelo generativo en la nube (prueba de la Parte 4)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="180" height="60" as="geometry"/></mxCell><mxCell id="s3" value="Compartición" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Se publica el reporte y accesos_anonimizado en el repositorio; nunca el original.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Líder del proyecto&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Seudónimos P001… y generalización de franja/semana; la llave tabla_seudonimos no se sube." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#FFFFFF;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="850" y="310" width="220" height="210" as="geometry"/></mxCell><mxCell id="x3" value="Repositorio externo (GitHub)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="180" height="60" as="geometry"/></mxCell><mxCell id="s4" value="Retención" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Se conserva el archivo anonimizado para el análisis y el reporte.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Líder del proyecto&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Plazo definido de conservación y revisión periódica del repositorio." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#FFFFFF;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1120" y="310" width="220" height="210" as="geometry"/></mxCell><mxCell id="s5" value="Eliminación" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Se borra accesos_crudo y la llave de seudónimos al terminar el análisis.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Líder del proyecto / administrador del sistema&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Borrado seguro y confirmación documentada de la eliminación." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#FFFFFF;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1390" y="310" width="220" height="210" as="geometry"/></mxCell><mxCell id="a0" style="endArrow=classic;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#FF0000;strokeWidth=3;endArrow=classic;exitX=0.8;exitY=0;entryX=0.2;entryY=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" style="endArrow=classic;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#FF0000;strokeWidth=3;endArrow=classic;exitX=0.8;exitY=0;entryX=0.2;entryY=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" style="endArrow=classic;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#FF0000;strokeWidth=3;endArrow=classic;exitX=0.8;exitY=0;entryX=0.2;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" style="endArrow=classic;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#FF0000;strokeWidth=3;endArrow=classic;exitX=0.8;exitY=0;entryX=0.2;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" style="endArrow=classic;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#FF0000;strokeWidth=3;endArrow=classic;exitX=0.8;exitY=0;entryX=0.2;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rx1" style="strokeColor=#FF0000;strokeWidth=2;dashed=1;endArrow=classic;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="s1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rx2" style="strokeColor=#FF0000;strokeWidth=2;dashed=1;endArrow=classic;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="s2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rx3" style="strokeColor=#FF0000;strokeWidth=2;dashed=1;endArrow=classic;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="s3" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>